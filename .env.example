# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database
DATABASE_URL=postgres://delivery_user:delivery_pass@db:5432/delivery_hub

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Set to False to run tasks synchronously (no Redis/Celery needed, e.g. Render free tier)
USE_CELERY=True
# Set to True to enable file-based logging (logs/delivery_hub.log). Default False for Render.
USE_FILE_LOGGING=False

# Email (Console backend for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@deliveryhub.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Initial User Credentials (for seed_users command)
# Admin User
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@deliveryhub.com

# Hub Manager User
HUB_MANAGER_USERNAME=manager
HUB_MANAGER_PASSWORD=manager123
HUB_MANAGER_EMAIL=manager@deliveryhub.com

# Rider User
RIDER_USERNAME=rider
RIDER_PASSWORD=rider123
RIDER_EMAIL=rider@deliveryhub.com
